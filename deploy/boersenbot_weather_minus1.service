[Unit]
Description=Weather -1-Klasse Auto-Lay V2 (Preisband 0,70-0,90, Rang nach Temperaturabstand, Cap 8, 5 USD/Lay) — V1 unter Tag autobuy-v1
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=veit
WorkingDirectory=/home/veit/boersenbot
ExecStart=/home/veit/boersenbot/venv/bin/python /home/veit/boersenbot/weather_minus1_autobuy.py
StandardOutput=append:/home/veit/boersenbot/logs/weather_minus1.log
StandardError=append:/home/veit/boersenbot/logs/weather_minus1.log
